# =============================================================================
# Production (alexiswebworks.com) — configure in Jenkins credentials / inject
# =============================================================================
#
# Docker BUILD (required — baked into static SEO routes):
#   docker build \
#     --build-arg NEXT_PUBLIC_SITE_URL=https://alexiswebworks.com \
#     -t alexiswebworks-portfolio:latest .
#
# Container RUNTIME (secrets — never pass as --build-arg):
#   BREVO_API_KEY
#   BREVO_SENDER_EMAIL
#   BREVO_SENDER_NAME=Alexis Portfolio
#   BREVO_CONTACT_TO_EMAIL=
#   GOOGLE_SITE_VERIFICATION=   (optional)
#   PORT=3000                     (optional, default 3000)
#
# =============================================================================

NEXT_PUBLIC_SITE_URL=https://alexiswebworks.com

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Alexis Portfolio
BREVO_CONTACT_TO_EMAIL=

# GOOGLE_SITE_VERIFICATION=
