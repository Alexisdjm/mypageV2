# =============================================================================
# Production — Jenkins Docker **build** args (baked into client bundle + SEO)
# =============================================================================
#
#   docker build \
#     --build-arg NEXT_PUBLIC_SITE_URL=https://alexiswebworks.com \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.alexiswebworks.com \
#     -t alexis-frontend:${BUILD_NUMBER} .
#
# Runtime (optional): GOOGLE_SITE_VERIFICATION on the container if you use it.
# Brevo credentials live on api.alexiswebworks.com — not on this frontend.
#
# =============================================================================

NEXT_PUBLIC_SITE_URL=https://alexiswebworks.com
NEXT_PUBLIC_API_URL=https://api.alexiswebworks.com

# GOOGLE_SITE_VERIFICATION=
