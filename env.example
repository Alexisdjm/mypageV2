# Public URL (no trailing slash). Required at Docker **build** for sitemap/OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Search Console verification (meta tag content only)
# GOOGLE_SITE_VERIFICATION=

# Brevo — contact form (/api/contact)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Alexis Portfolio
BREVO_CONTACT_TO_EMAIL=
