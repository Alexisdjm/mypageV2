# =============================================================================
# Local development — copy to `.env.local` (not committed)
# =============================================================================

# Frontend URL (no trailing slash). Docker build arg for sitemap/OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base URL (no trailing slash). Contact form POSTs to {API_URL}/contact
NEXT_PUBLIC_API_URL=https://api.alexiswebworks.com

# Optional: Google Search Console verification (meta tag content only)
# GOOGLE_SITE_VERIFICATION=
